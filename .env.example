# OpenAI API key — optional. Without it, the AI panel uses a local fallback
# (Generate) and local ELK layout (Cleanup); only live Generate/Explain need it.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Optional: override the model (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Public site URL — used for canonical/OG metadata (set to your deployed origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
